# EDITH backend (Python) 环境变量配置
# 复制为 .env 或放在仓库根目录，与 Go 版 backend-v2 共用同一套配置。

# 服务监听地址（对应 Go 版 EDITH_ADDR）
EDITH_ADDR=127.0.0.1:8080

# SQLite 数据库路径（对应 Go 版 EDITH_DB_PATH）
EDITH_DB_PATH=edith-v2.db

# E2B Sandbox 模板（必填，对应 Go 版 EDITH_E2B_TEMPLATE）
EDITH_E2B_TEMPLATE=

# E2B API Key（对应 Go 版 E2B_API_KEY）
E2B_API_KEY=

# 工作区 Volume 后端：e2b（默认，真实 E2B Volume，需账号启用 Sandbox Volumes）
# 或 local（本地目录模拟，不消耗 E2B 配额，本地开发/演示用；沙箱创建后自动同步文件）
# EDITH_WORKSPACE_VOLUME_BACKEND=e2b
# 本地模式的数据目录（可选，默认 workspace-volumes）
# EDITH_WORKSPACE_VOLUME_DIR=workspace-volumes

# 腾讯云 COS 对象存储（对应 Go 版 EDITH_COS_*）
EDITH_COS_BUCKET=
EDITH_COS_REGION=
EDITH_COS_SECRET_ID=
EDITH_COS_SECRET_KEY=

# 凭据混淆密钥（可选）。用于混淆落盘的 API Key / MCP Header，防止明文直接写库。
# 不设置时使用内置 fallback key（防君子不防小人）；上多用户/云端部署前必须替换为
# 强随机值或专用密钥管理，否则拿到数据库文件 + 源码即可还原。
EDITH_SECRET_KEY=
