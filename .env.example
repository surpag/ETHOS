# EDITH 开发配置模板
# 复制为根目录 .env 并填入真实值：cp .env.example .env
# 仓库中不保存任何真实密钥；docker compose 会自动读取根目录 .env

# ── 后端 backend ───────────────────────────────────────────────
# E2B Sandbox 模板名（e2b-template/edith-sandbox-python）
EDITH_E2B_TEMPLATE=edith-sandbox-python
# E2B API Key（https://e2b.dev/dashboard）
E2B_API_KEY=

# 腾讯云 COS（图片存储）
EDITH_COS_BUCKET=
EDITH_COS_REGION=ap-guangzhou
EDITH_COS_SECRET_ID=
EDITH_COS_SECRET_KEY=

# 工作区存储后端：E2B Volume 未开通（private beta）时请用 local
EDITH_WORKSPACE_VOLUME_BACKEND=local

# ── 前端 web-v1 ────────────────────────────────────────────────
# Clerk 凭证（https://dashboard.clerk.com）
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Clerk 路由（有默认值，一般不用改）
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/
