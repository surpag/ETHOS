# ─────────────────────────────────────────────────────────────
# 生产环境配置模板：复制为根目录 .env 后填写真实值
#   cp .env.production.example .env && chmod 600 .env
#
# 警告：.env 含真实密钥，务必确认 .gitignore 已忽略，切勿提交。
# ─────────────────────────────────────────────────────────────

# ── 后端：E2B 沙箱 ───────────────────────────────────────────
# 必须与你在 E2B 后台实际存在的模板名一致（当前项目用的是 edith-sandbox-python）
EDITH_E2B_TEMPLATE=edith-sandbox-python
E2B_API_KEY=

# ── 后端：腾讯云 COS（对话图片存储）──────────────────────────
EDITH_COS_BUCKET=
EDITH_COS_REGION=ap-guangzhou
EDITH_COS_SECRET_ID=
EDITH_COS_SECRET_KEY=

# ── 后端：工作区存储后端 ─────────────────────────────────────
# E2B Volume 目前是 private beta（未开通会 403），生产先用 local
# 本地卷落在容器 /app/data/workspace-volumes，由 edith-data 命名卷持久化
EDITH_WORKSPACE_VOLUME_BACKEND=local

# ── 前端：Clerk 认证 ─────────────────────────────────────────
# 生产实例必须配 HTTPS 域名，并在 Clerk Dashboard 添加该域名
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/

# ── 可选：运行时可调参数（不填用默认值）─────────────────────
# 单次任务最大工具轮次（安全网，默认 30）
# EDITH_MAX_TOOL_ROUNDS=30
# 工作区同步：单文件上限 / 单次读取超时 / 连续失败熔断阈值
# EDITH_SYNC_MAX_FILE_BYTES=2097152
# EDITH_SYNC_READ_TIMEOUT_S=15
# EDITH_SYNC_FAILURE_LIMIT=3
# 沙箱出口域名白名单（逗号分隔，≤10 个；留空=全放通）
# EDITH_SANDBOX_ALLOWED_DOMAINS=
